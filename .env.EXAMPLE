GLITCH_CRYPTO_GATEWAY_URL=http://127.0.0.1:8791
GLITCH_CRYPTO_LOCAL_TOKEN=replace-with-the-gateway-model-token
GLITCH_CRYPTO_OPERATOR_TOKEN=replace-with-the-gateway-operator-token

# Event-driven live-shadow operator. The worker sees gateway evidence only.
GLITCH_CRYPTO_OPERATOR_POLL_SECONDS=0.5
GLITCH_CRYPTO_OPERATOR_MIN_INTERVAL_SECONDS=5
GLITCH_CRYPTO_OPERATOR_MODEL_TIMEOUT_SECONDS=120
